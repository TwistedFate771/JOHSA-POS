#define MyAppName "Enterprise POS"
#define MyAppVersion "1.0.0"
#define MyAppExeName "JOHSA-POS.WinForms.exe"
#define DoubleAmp(Value) StringChange(Value, "&", "&&")
#define EscapeConstArgument(Value) StringChange(StringChange(StringChange(Value, "%", "%25"), ",", "%2c"), "}", "%7d")

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{D21BC234-6CC2-4196-94F3-FA86E617167A}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={cm:NameAndVersion,{#EscapeConstArgument(MyAppName)},{#EscapeConstArgument(MyAppVersion)}}
DefaultDirName={autopf}\EnterprisePOS
PrivilegesRequired=admin
ArchitecturesInstallIn64BitMode=x64compatible
UninstallDisplayIcon={app}\{#MyAppExeName}
DisableProgramGroupPage=yes
; Uncomment the following line to run in non administrative install mode (install for current user only).
;PrivilegesRequired=lowest
OutputBaseFilename=JOHSA-POS_Setup
SolidCompression=yes
WizardStyle=modern dynamic

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "C:\Users\leste\source\repos\JOHSA-POS\JOHSA-POS.WinForms\bin\Release\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\leste\source\repos\JOHSA-POS\JOHSA-POS.WinForms\bin\Release\JOHSA-POS.Data.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\leste\source\repos\JOHSA-POS\JOHSA-POS.WinForms\bin\Release\JOHSA-POS.Data.dll.config"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\leste\source\repos\JOHSA-POS\JOHSA-POS.WinForms\bin\Release\JOHSA-POS.Domain.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\leste\source\repos\JOHSA-POS\JOHSA-POS.WinForms\bin\Release\JOHSA-POS.Services.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\leste\source\repos\JOHSA-POS\JOHSA-POS.WinForms\bin\Release\JOHSA-POS.WinForms.exe.config"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\leste\source\repos\JOHSA-POS\JOHSA-POS.WinForms\bin\Release\Database\sacares_LocalDB.mdf"; DestDir: "{app}\Database"; Flags: ignoreversion
Source: "C:\Users\leste\source\repos\JOHSA-POS\JOHSA-POS.WinForms\bin\Release\Database\sacares_LocalDB_log.ldf"; DestDir: "{app}\Database"; Flags: ignoreversion
Source: "C:\Users\leste\source\repos\JOHSA-POS\Prerequisites\SqlLocalDB.msi"; DestDir: "{tmp}"; Flags: deleteafterinstall
Source: "C:\Users\leste\source\repos\JOHSA-POS\Prerequisites\NDP48-x86-x64-AllOS-ENU.exe"; DestDir: "{tmp}"; Flags: deleteafterinstall
; NOTE: Don't use "Flags: ignoreversion" on any shared system files.

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{tmp}\NDP48-x86-x64-AllOS-ENU.exe"; Parameters: "/q /norestart"; StatusMsg: "Installing .NET Framework 4.8..."; Flags: waituntilterminated runhidden; Check: not IsDotNet48Installed(); AfterInstall: VerifyDotNet48
Filename: "msiexec.exe"; Parameters: "/i ""{tmp}\SqlLocalDB.msi"" /qn /norestart"; StatusMsg: "Installing SQL Server LocalDB..."; Flags: waituntilterminated runhidden; Check: not IsLocalDBInstalled(); AfterInstall: VerifyLocalDB
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#DoubleAmp(MyAppName)}}"; Flags: nowait postinstall skipifsilent

[Code]

function IsDotNet48Installed(): Boolean;
var
  Release: Cardinal;
begin
  Result := False;

  if IsWin64 then
  begin
    if RegQueryDWordValue(
      HKLM64,
      'SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full',
      'Release',
      Release
    ) then
      Result := Release >= 528040;
  end
  else
  begin
    if RegQueryDWordValue(
      HKLM,
      'SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full',
      'Release',
      Release
    ) then
      Result := Release >= 528040;
  end;
end;

function IsLocalDBInstalled(): Boolean;
begin
  if IsWin64 then
    Result := RegKeyExists(
      HKLM64,
      'SOFTWARE\Microsoft\Microsoft SQL Server Local DB\Installed Versions\17.0'
    )
  else
    Result := RegKeyExists(
      HKLM,
      'SOFTWARE\Microsoft\Microsoft SQL Server Local DB\Installed Versions\17.0'
    );
end;
procedure VerifyDotNet48();
begin
  if not IsDotNet48Installed() then
  begin
    RaiseException('.NET Framework 4.8 installation failed. Please restart your computer and try again.');
  end;
end;

procedure VerifyLocalDB();
begin
  if not IsLocalDBInstalled() then
  begin
    RaiseException('SQL Server LocalDB installation failed. Please restart your computer and try again.');
  end;
end;
